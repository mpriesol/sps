# Copy to sps.env. Docker Compose >= 2.30 reads it in raw mode.
# Values are literal: do NOT wrap them in quotes, including passwords.
PUBLIC_URL=https://hub.biketrek.sk/sps
APP_PASSWORD=CHANGE_TO_A_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
SESSION_HOURS=12

# true = demo (no calls to SPS), false = live receiving
SPS_DEMO=true
SPS_USERNAME=
SPS_PASSWORD=
